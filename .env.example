# Backend: copy to backend/.env, or export these variables in your shell.
# Relative SQLite paths resolve against backend/ when started there.
HABITFLOW_DATABASE_URL=sqlite:///./data/habitflow.db
HABITFLOW_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# Frontend Vite proxy (optional, never contains a secret)
VITE_API_TARGET=http://127.0.0.1:8000
